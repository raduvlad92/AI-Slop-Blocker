{
  "manifest_version": 3,
  "name": "AI Slop Blocker",
  "version": "0.1.1",
  "description": "Hide English Google AI Overviews and manually block YouTube videos, Shorts, or channels. Optional community reports.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },

  "permissions": ["storage", "alarms"],

  "host_permissions": [
    "*://*.google.com/search*",
    "*://*.youtube.com/*",
    "https://raw.githubusercontent.com/*",
    "https://aislopblocker-api.radu-vlad-92.workers.dev/*"
  ],

  "background": {
    "service_worker": "background.js",
    "type": "module"
  },

  "content_scripts": [
    {
      "matches": ["*://*.google.com/search*"],
      "js": ["content/common.js", "content/google.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["content/channel-identity.js", "content/common.js", "content/youtube.js"],
      "css": ["content/youtube.css"],
      "run_at": "document_start"
    }
  ],

  "options_page": "options/options.html",

  "action": {
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    },
    "default_popup": "popup/popup.html",
    "default_title": "AI Slop Blocker"
  }
}
