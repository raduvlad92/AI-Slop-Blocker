{
  "name": "ai-slop-blocker",
  "private": true,
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node tests/browser/serve.mjs",
    "validate": "node .github/validate-blocklist.js",
    "review:admin": "node scripts/review-admin.mjs",
    "package": "python3 scripts/package-release.py",
    "test:browser:ci": "node tests/browser/run.mjs",
