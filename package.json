    "lint:firefox": "web-ext lint --source-dir releases/firefox --warnings-as-errors"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "devDependencies": {
    "playwright": "1.65.0",
    "web-ext": "10.8.0"
  }
}
